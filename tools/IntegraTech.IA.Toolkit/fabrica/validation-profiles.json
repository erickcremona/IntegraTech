{
  "schema_version": 1,
  "profiles": {
    "node-tests-v1": {
      "execution_mode": "host_controlled",
      "isolation": "unverified",
      "runtime": "current-node",
      "command": [
        "node",
        "--test",
        "--test-isolation=process",
        "<frozen-original-test-files>"
      ],
      "criteria": [
        "nonzero-test-files",
        "all-tests-pass",
        "host-controls-pass",
        "frozen-original-regression-oracles"
      ],
      "network": "available-to-the-current-user"
    },
    "dotnet-offline-v1": {
      "execution_mode": "host_controlled",
      "isolation": "unverified",
      "runtime": "current-host-dotnet-sdk-required",
      "commands": [
        [
          "dotnet",
          "restore",
          "<architecture-project>",
          "--source",
          "<empty-temporary-package-source>",
          "-p:NuGetAudit=false"
        ],
        [
          "dotnet",
          "build",
          "<architecture-project>",
          "--no-restore"
        ],
        [
          "dotnet",
          "run",
          "--project",
          "<architecture-project>",
          "--no-build",
          "--no-restore"
        ]
      ],
      "criteria": [
        "nonzero-architecture-tests",
        "build-pass",
        "tests-pass",
        "host-controls-pass",
        "frozen-original-regression-oracles"
      ],
      "network": "available-to-the-current-user",
      "availability": "requires-current-host-sdk-and-local-dependencies"
    }
  }
}
