{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Contexto do negócio v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "problem", "current_situation", "stakeholders", "desired_outcomes", "success_criteria", "scope", "out_of_scope", "known_rules", "data", "constraints", "integrations", "open_questions", "assumptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "problem": { "type": "string", "minLength": 1 }, "current_situation": { "type": "string", "minLength": 1 },
    "stakeholders": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "desired_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "known_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "data": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "integrations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "open_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
