{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decis\u00e3o tecnol\u00f3gica vinculada ao contexto",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "drivers",
    "options",
    "selected_option",
    "research",
    "validation",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_sha256": {
      "type": "string",
      "minLength": 1
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stack",
          "presentation",
          "technologies",
          "rationale",
          "consequences",
          "source_urls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stack": {
            "type": "string",
            "minLength": 1
          },
          "presentation": {
            "enum": [
              "worker",
              "api",
              "console",
              "none"
            ]
          },
          "technologies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "consequences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "interface": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "framework"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "web",
                  "native",
                  "none"
                ]
              },
              "framework": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "rendering": {
                "type": "string",
                "minLength": 1
              },
              "component_library": {
                "type": "string",
                "minLength": 1
              },
              "style_strategy": {
                "type": "string",
                "minLength": 1
              },
              "design_system": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "accessibility": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "validation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_roots": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "selected_option": {
      "type": "string",
      "minLength": 1
    },
    "research": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "accessed_at",
          "status",
          "findings"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "consulted",
              "unavailable"
            ]
          },
          "findings": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
