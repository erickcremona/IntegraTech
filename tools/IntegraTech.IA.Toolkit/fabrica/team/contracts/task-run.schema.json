{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integratech.local/contracts/task-run-v1.schema.json",
  "title": "IntegraTech durable task run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task_id", "provider", "phase", "assigned_agent", "human_gate", "ownership", "status", "revision", "attempts", "correction_count", "snapshot", "delegation_sha256", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "enum": ["codex", "claude", "cursor"] },
    "phase": { "type": "string", "enum": ["toolkit", "discovery", "design", "business"] },
    "assigned_agent": { "type": "string", "minLength": 1 },
    "human_gate": { "type": "string", "enum": ["none", "required", "pending"] },
    "ownership": {
      "type": "object", "additionalProperties": false, "required": ["read", "write"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "type": "string", "enum": ["awaiting_gate", "implementation_pending"] },
    "revision": { "type": "integer", "minimum": 1 },
    "attempts": { "type": "integer", "minimum": 0 },
    "correction_count": { "type": "integer", "minimum": 0 },
    "snapshot": { "type": "string", "minLength": 64 },
    "delegation_sha256": { "type": "string", "minLength": 64 },
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "type", "at"],
        "properties": {
          "revision": { "type": "integer", "minimum": 1 },
          "type": { "type": "string", "enum": ["task_created", "gate_checked"] },
          "result": { "type": "string", "enum": ["ready", "blocked"] },
          "reason": { "type": "string" },
          "at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
