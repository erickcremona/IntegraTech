{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integratech.local/contracts/task-run-v1.schema.json",
  "title": "IntegraTech durable task run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_id",
    "provider",
    "phase",
    "assigned_agent",
    "human_gate",
    "ownership",
    "status",
    "revision",
    "attempts",
    "correction_count",
    "snapshot",
    "delegation_sha256",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "cursor"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "toolkit",
        "discovery",
        "design",
        "business"
      ]
    },
    "assigned_agent": {
      "type": "string",
      "minLength": 1
    },
    "human_gate": {
      "type": "string",
      "enum": [
        "none",
        "required",
        "pending"
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write"
      ],
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_gate",
        "implementation_pending",
        "validation_pending",
        "validating",
        "validation_blocked",
        "review_pending",
        "reviewing",
        "review_blocked",
        "correction_pending",
        "ready_for_delivery"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "correction_count": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot": {
      "type": "string",
      "minLength": 64
    },
    "delegation_sha256": {
      "type": "string",
      "minLength": 64
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "type",
          "at"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "task_created",
              "gate_checked",
              "candidate_accepted",
              "validation_started",
              "validation_finished",
              "review_started",
              "review_finished",
              "operation_interrupted",
              "provider_changed"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "baseline_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          }
        }
      }
    },
    "delegation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://integratech.local/contracts/delegation-v1.schema.json",
      "title": "IntegraTech Agent Delegation v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "objective",
        "business_context",
        "technical_context",
        "scope",
        "out_of_scope",
        "assigned_agent",
        "supporting_agents",
        "required_inputs",
        "expected_deliverables",
        "constraints",
        "file_ownership",
        "risks",
        "acceptance_criteria",
        "validation_commands",
        "evidence_required",
        "deadline_or_priority",
        "human_gate"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "business_context": {
          "type": "string"
        },
        "technical_context": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assigned_agent": {
          "type": "string",
          "minLength": 1
        },
        "supporting_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deadline_or_priority": {
          "type": "string",
          "minLength": 1
        },
        "human_gate": {
          "type": "string",
          "enum": [
            "none",
            "required",
            "pending"
          ]
        }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "node-tests-v1",
            "dotnet-offline-v1"
          ]
        },
        "profile_sha256": {
          "type": "string",
          "minLength": 64
        },
        "candidate_sha256": {
          "type": "string",
          "minLength": 64
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 64
              }
            }
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_reviews": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "code",
              "security"
            ]
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "code",
                  "security"
                ]
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 64
              },
              "package_sha256": {
                "type": "string",
                "minLength": 64
              },
              "candidate_sha256": {
                "type": "string",
                "minLength": 64
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "approved",
                  "approved_with_findings",
                  "changes_required",
                  "blocked"
                ]
              }
            },
            "required": [
              "type",
              "run_id",
              "path",
              "sha256",
              "package_sha256",
              "candidate_sha256",
              "verdict"
            ]
          }
        },
        "review_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_sha256": {
                "type": "string",
                "minLength": 64
              }
            },
            "required": [
              "type",
              "task_id",
              "candidate_sha256"
            ]
          }
        },
        "validation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "blocked"
              ]
            },
            "reason_code": {
              "type": "string",
              "minLength": 1
            },
            "isolation": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "code"
                ]
              }
            },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "runtime": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "platform",
                "runtime"
              ]
            },
            "candidate_sha256": {
              "type": "string",
              "minLength": 64
            },
            "profile_sha256": {
              "type": "string",
              "minLength": 64
            },
            "oracle_sha256": {
              "type": "string",
              "minLength": 64
            }
          },
          "required": [
            "status",
            "reason_code",
            "isolation",
            "checks",
            "environment",
            "candidate_sha256",
            "profile_sha256",
            "oracle_sha256"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 64
          }
        },
        "spent_ms": {
          "type": "integer",
          "minimum": 0
        },
        "automatic_executor": {
          "const": false
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "validation",
                "review"
              ]
            },
            "started_at": {
              "type": "string",
              "minLength": 1
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "started_at",
            "pid"
          ]
        }
      },
      "required": [
        "version",
        "profile",
        "profile_sha256",
        "candidate_sha256",
        "files",
        "changed_files",
        "required_reviews",
        "reviews",
        "review_attempts",
        "validation",
        "history",
        "spent_ms",
        "automatic_executor"
      ]
    },
    "oracle_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "validation_pending",
              "validating",
              "validation_blocked",
              "review_pending",
              "reviewing",
              "review_blocked",
              "correction_pending",
              "ready_for_delivery"
            ]
          }
        }
      },
      "then": {
        "required": [
          "baseline_files",
          "delegation",
          "engineering",
          "oracle_files"
        ]
      }
    }
  ]
}
