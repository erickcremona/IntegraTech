{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "context_sha256",
    "preparation_sha256",
    "skill_sha256",
    "findings",
    "domain_impacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "context_sha256": {
      "type": "string",
      "minLength": 1
    },
    "preparation_sha256": {
      "type": "string",
      "minLength": 1
    },
    "skill_sha256": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain_impacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
