{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared contextual interface profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "technology_sha256",
    "selection",
    "profile_sha256",
    "skill_path",
    "validation_path",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_sha256": {
      "type": "string",
      "minLength": 64
    },
    "technology_sha256": {
      "type": "string",
      "minLength": 64
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "framework"
      ],
      "properties": {
        "platform": {
          "enum": [
            "web",
            "native",
            "none"
          ]
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rendering": {
          "type": "string",
          "minLength": 1
        },
        "component_library": {
          "type": "string",
          "minLength": 1
        },
        "style_strategy": {
          "type": "string",
          "minLength": 1
        },
        "design_system": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profile_sha256": {
      "type": "string",
      "minLength": 64
    },
    "skill_path": {
      "type": "string",
      "minLength": 1
    },
    "validation_path": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          }
        }
      }
    }
  }
}
