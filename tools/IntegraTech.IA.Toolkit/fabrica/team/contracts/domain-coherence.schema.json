{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "preparation_sha256",
    "skill_sha256",
    "snapshot_sha256",
    "assessments",
    "changes",
    "pending"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_sha256": {
      "type": "string",
      "minLength": 1
    },
    "preparation_sha256": {
      "type": "string",
      "minLength": 1
    },
    "skill_sha256": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "minLength": 1
    },
    "assessments": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "conclusion",
          "status"
        ],
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "blocked"
            ]
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pending": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "blocking"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
