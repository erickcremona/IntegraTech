{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integratech.local/contracts/review-v1.schema.json",
  "title": "IntegraTech Agent Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "review_type",
    "verdict",
    "findings",
    "residual_risk"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "review_type": {
      "type": "string",
      "enum": [
        "code",
        "security",
        "data",
        "architecture",
        "ux_accessibility"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_findings",
        "changes_required",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "evidence",
          "path",
          "line",
          "impact",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "security_reference": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": { "type": "string", "minLength": 1 },
          "affected_component": { "type": "string", "minLength": 1 },
          "affected_module": { "type": "string", "minLength": 1 },
          "decision_ref": { "type": "string", "minLength": 1 },
          "functional_impact": { "type": "string", "minLength": 1 },
          "technical_impact": { "type": "string", "minLength": 1 },
          "operational_impact": { "type": "string", "minLength": 1 },
          "alternatives_considered": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "affected_feature": { "type": "string", "minLength": 1 },
          "affected_flow": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "cause_hypothesis": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 1 },
          "required_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "resolution_status": { "type": "string", "enum": ["open", "planned", "in_progress", "implemented", "awaiting_revalidation", "verified_resolved"] }
          }
        }
      },
    "residual_risk": {
      "type": "string"
    },
    "ux_assessment": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "score",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "enum": [
              "task_clarity",
              "visual_hierarchy",
              "visual_identity",
              "interaction_states",
              "responsive_behavior",
              "accessibility",
              "performance"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
