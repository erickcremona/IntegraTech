{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functional-spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_sha256": {
      "type": "string",
      "minLength": 64
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "scenarios"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "given",
                "when",
                "then"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
