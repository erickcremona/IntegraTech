{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano de negócio SDD v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "objective",
    "scope",
    "out_of_scope",
    "risks",
    "phases",
    "consultation_paths",
    "specification_path",
    "specification_sha256",
    "design_path",
    "design_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "context_sha256": {
      "type": "string",
      "minLength": 64
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deliverables",
          "acceptance_criteria",
          "validation_commands",
          "depends_on",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation_commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "requirement_ids",
                "scenario_ids",
                "owner",
                "read_files",
                "write_files",
                "deliverables",
                "validation_commands",
                "test_paths"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "scenario_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "read_files": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "write_files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "deliverables": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "validation_commands": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "test_paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "consultation_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "specification_path": {
      "type": "string",
      "minLength": 1
    },
    "specification_sha256": {
      "type": "string",
      "minLength": 64
    },
    "design_path": {
      "type": "string",
      "minLength": 1
    },
    "design_sha256": {
      "type": "string",
      "minLength": 64
    },
    "source_binding_sha256": {
      "type": "string",
      "minLength": 64
    },
    "architecture_sha256": {
      "type": "string",
      "minLength": 64
    }
  }
}
