{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "technical-design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_sha256",
    "specification_sha256",
    "architecture",
    "decisions",
    "validation_strategy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_sha256": {
      "type": "string",
      "minLength": 64
    },
    "specification_sha256": {
      "type": "string",
      "minLength": 64
    },
    "architecture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_strategy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "system_design": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "system-design",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "decision",
        "rationale",
        "signals",
        "components",
        "flows",
        "data_boundaries",
        "integrations",
        "failure_modes",
        "quality_attributes",
        "security",
        "observability",
        "ux_touchpoints",
        "validation_strategy"
      ],
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "not_required",
            "recommended",
            "required"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "included",
            "deferred",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_id",
              "kind",
              "evidence"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "multiple_components",
                  "critical_external_integration",
                  "payment_or_financial_flow",
                  "regulated_data_boundary",
                  "cross_system_consistency",
                  "availability_requirement",
                  "performance_requirement",
                  "distributed_runtime",
                  "complex_async_workflow",
                  "resilience_requirement"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_attributes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observability": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ux_touchpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_strategy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defer_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
